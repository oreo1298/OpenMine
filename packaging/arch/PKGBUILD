# Maintainer: OpenMine contributors <https://github.com/oreo1298/OpenMine>
#
# Builds OpenMine from the latest commit on GitHub.
#   Install / update:  makepkg -si
#   Uninstall:         sudo pacman -Rns openmine-git

pkgname=openmine-git
_pkgname=openmine
_appid=io.github.oreo1298.OpenMine
pkgver=1.0.0
pkgrel=1
pkgdesc="Free and open source Minesweeper that follows your system theme"
arch=('any')
url="https://github.com/oreo1298/OpenMine"
license=('GPL-3.0-or-later')
depends=('python' 'pyside6')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest')
optdepends=('qt6-wayland: native Wayland support'
            'xdg-desktop-portal: follow the desktop accent colour and dark style')
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  local version
  version="$(sed -n 's/^__version__ = "\(.*\)"/\1/p' src/openmine/__init__.py)"
  printf '%s.r%s.g%s' "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd "$_pkgname"
  python -m build --wheel --no-isolation
}

check() {
  cd "$_pkgname"
  QT_QPA_PLATFORM=offscreen python -m pytest -q tests
}

package() {
  cd "$_pkgname"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 "data/$_appid.desktop" -t "$pkgdir/usr/share/applications/"
  install -Dm644 "data/$_appid.metainfo.xml" -t "$pkgdir/usr/share/metainfo/"
  install -Dm644 "data/icons/$_appid.svg" -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  local png size
  for png in src/openmine/assets/"$_appid"-*.png; do
    size="${png##*-}"
    size="${size%.png}"
    install -Dm644 "$png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/$_appid.png"
  done
}
